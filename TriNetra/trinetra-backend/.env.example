# TriNetra Backend environment template.
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
#
# ── Core ─────────────────────────────────────────────────────────────────
# PostgreSQL (Neon) connection string for the primary investigation database.
NEON_DATABASE_URL=

# Secret used to sign/verify JWT tokens issued by /api/login.
JWT_SECRET=

# ── AI providers ─────────────────────────────────────────────────────────
# Groq API key (LLM planner, NL2SQL regeneration, prose synthesis).
GROQ_API_KEY=

# Sarvam AI (English/Kannada speech-to-text + translation).
SARVAM_API_KEY=

# Google Gemini (reserved).
GEMINI_API_KEY=

# ── Persistent chat history (Catalyst Data Store) ────────────────────────
# Backend selection: "auto" (Catalyst when configured, else in-memory),
# "catalyst" (require Catalyst), or "memory" (in-memory dev fallback).
CHAT_STORE_BACKEND=auto

# Catalyst credentials for non-AppSail runs (local/CI):
#   CATALYST_AUTH     - JSON string with {"refresh_token": "..."} (or an
#                       access token / ticket) from a Catalyst service account.
#   CATALYST_OPTIONS  - JSON string {"project_id": ..., "project_key": ...,
#                       "project_domain": ...} for the Catalyst project.
# Inside Zoho Catalyst AppSail these are injected by the runtime and do not
# need to be set here.
CATALYST_AUTH=
CATALYST_OPTIONS=

# Optional read-only database role used by the NL2SQL read-only guardrail.
READONLY_DB_URL=
